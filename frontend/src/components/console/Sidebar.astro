---
export interface Props {
  activePath?: string;
}

const { activePath = '/console' } = Astro.props;

const siteName = "笔阵";
const userName = "用户";

const sidebarItems = [
  { icon: "🏠", label: "控制台", href: "/console" },
  { icon: "📄", label: "试卷空间", href: "/console/papers" },
  { icon: "❓", label: "题库", href: "/console/questions" },
  { icon: "🎨", label: "模板", href: "/console/templates" },
  { icon: "📊", label: "数据统计", href: "/console/analytics" },
  { icon: "⚙️", label: "设置", href: "/console/settings" },
];

const favorites = [
  { name: "常用数学公式库", emoji: "🔢", href: "/console/questions?tag=math" },
  { name: "物理实验报告模板", emoji: "📋", href: "/console/templates/physics" },
  { name: "英语听力训练集", emoji: "🎧", href: "/console/questions?tag=english" },
];
---

<aside class="sidebar">
  <div class="sidebar-header">
    <a href="/" class="logo">
      <img src="/exam-icon.svg" alt="笔阵图标" class="site-icon" />
      <span>{siteName}</span>
    </a>
  </div>

  <div class="sidebar-search">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <span class="search-text">搜索</span>
      <span class="search-shortcut">⌘+P</span>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      {sidebarItems.map(item => (
        <a href={item.href} class={`nav-item ${item.href === activePath ? 'active' : ''}`}>
          <span class="nav-icon">{item.icon}</span>
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="nav-section">
      <div class="section-header">
        <span>收藏</span>
        <button class="add-btn">+</button>
      </div>
      {favorites.map(item => (
        <a href={item.href} class="nav-item">
          <span class="nav-icon">{item.emoji}</span>
          <span class="nav-label">{item.name}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="user-menu">
      <div class="user-avatar">{userName[0]}</div>
      <span class="user-name">{userName}</span>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 240px;
    background: #f7f6f3;
    border-right: 1px solid #e3e2e0;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
  }

  .sidebar-header {
    padding: 0.75rem 0.875rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #37352f;
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    transition: background 0.15s ease;
  }

  .logo:hover {
    background: #ebebea;
  }

  .site-icon {
    width: 20px;
    height: 20px;
  }

  .sidebar-search {
    padding: 0 0.875rem 0.5rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    background: #ebebea;
    border-radius: 4px;
    color: #6b6b6b;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .search-box:hover {
    background: #e3e2e0;
  }

  .search-icon {
    font-size: 0.75rem;
  }

  .search-text {
    flex: 1;
  }

  .search-shortcut {
    font-size: 0.6875rem;
    color: #6b6b6b;
    opacity: 0.6;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0 0.5rem;
  }

  .nav-section {
    margin-bottom: 0.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.375rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #6b6b6b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .add-btn {
    background: none;
    border: none;
    color: #6b6b6b;
    font-size: 1rem;
    cursor: pointer;
    padding: 0 0.25rem;
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .add-btn:hover {
    background: #ebebea;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 4px;
    color: #37352f;
    text-decoration: none;
    font-size: 0.875rem;
    transition: background 0.15s ease;
    margin-bottom: 1px;
  }

  .nav-item:hover {
    background: #ebebea;
  }

  .nav-item.active {
    background: #e3e2e0;
    font-weight: 500;
  }

  .nav-icon {
    font-size: 0.875rem;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .nav-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-footer {
    padding: 0.5rem;
    border-top: 1px solid #e3e2e0;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .user-menu:hover {
    background: #ebebea;
  }

  .user-avatar {
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: #4A90E2;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.625rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .user-name {
    font-size: 0.875rem;
    color: #37352f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }

    .sidebar.open {
      transform: translateX(0);
    }
  }
</style>
