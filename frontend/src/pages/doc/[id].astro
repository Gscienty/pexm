---
import Sidebar from '../../components/console/Sidebar.astro';
import TiptapEditor from '../../components/TiptapEditor.astro';

export interface Props {
  id: string;
}

export function getStaticPaths() {
  return [
    { params: { id: 'new' } },
    { params: { id: '2026年春季期中数学试卷' } },
    { params: { id: '高二物理力学综合测试' } },
    { params: { id: '英语阅读理解专项训练' } },
    { params: { id: '化学实验操作考核' } },
    { params: { id: '语文古诗词默写练习' } },
  ];
}

const { id } = Astro.props;

const siteName = "笔阵";

const initialContent = id === 'new'
  ? '<h1>新建试卷</h1><p>开始编辑您的试卷内容...</p>'
  : `<h1>2026年春季期中数学试卷</h1>
<p>本试卷共分为三个部分，满分150分，考试时间120分钟。</p>
<h2>第一部分：选择题（共50分）</h2>
<ul><li>每小题5分，共10小题</li><li>请将正确答案填写在答题卡上</li></ul>
<h2>第二部分：填空题（共40分）</h2>
<ol><li>每小题4分，共10小题</li><li>答案写在横线上</li><li>必须使用黑色签字笔书写</li></ol>
<h2>第三部分：解答题（共60分）</h2>
<p>解答应写出文字说明、证明过程或演算步骤。</p>
<blockquote>⚠️ 注意：请保持卷面整洁，书写工整。</blockquote>`;

---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{id === 'new' ? '新建试卷' : id} - {siteName}</title>
  </head>
  <body>
    <Sidebar activePath="/console/papers" />

    <div class="doc-layout">
      <header class="doc-header">
        <div class="doc-header-content">
          <nav class="doc-breadcrumb">
            <a href="/console" class="breadcrumb-link">控制台</a>
            <span class="breadcrumb-sep">/</span>
            <a href="/console/papers" class="breadcrumb-link">试卷空间</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">{id === 'new' ? '新建试卷' : id}</span>
          </nav>
          <div class="doc-actions">
            <button class="action-btn">
              <span class="action-icon">📋</span>
              分享
            </button>
            <button class="action-btn">
              <span class="action-icon">❤️</span>
              收藏
            </button>
            <button class="action-btn primary">
              <span class="action-icon">💾</span>
              保存
            </button>
          </div>
        </div>
      </header>

      <main class="doc-main">
        <aside class="doc-outline" id="docOutline">
          <div class="outline-header">大纲</div>
          <ul class="outline-list" id="outlineList"></ul>
        </aside>

        <div class="doc-container">
          <div class="doc-title" contenteditable="true" data-placeholder="试卷标题">{id === 'new' ? '新建试卷' : id}</div>

          <TiptapEditor content={initialContent} placeholder="输入 / 以使用命令..." class="doc-editor" />
        </div>
      </main>
    </div>
  </body>
</html>

<script>
  const docTitle = document.querySelector('.doc-title');
  const siteName = "笔阵";
  let isComposing = false;

  if (docTitle) {
    const updateTitles = () => {
      const text = docTitle.textContent?.trim() || '';
      if (!text) {
        docTitle.innerHTML = '';
      }
      const title = text || '未命名试卷';
      document.title = `${title} - ${siteName}`;
      const breadcrumbCurrent = document.querySelector('.breadcrumb-current');
      if (breadcrumbCurrent) {
        breadcrumbCurrent.textContent = title;
      }
    };

    docTitle.addEventListener('input', updateTitles);

    updateTitles();

    docTitle.addEventListener('compositionstart', () => {
      isComposing = true;
    });

    docTitle.addEventListener('compositionend', () => {
      isComposing = false;
    });

    docTitle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !isComposing) {
        e.preventDefault();
        const editor = document.querySelector('.ProseMirror');
        if (editor instanceof HTMLElement) {
          editor.focus();
        }
      }
    });
  }

  const outlineList = document.getElementById('outlineList');
  const docMain = document.querySelector('.doc-main');

  function renderOutline(headings: { id: string; text: string; level: number }[]) {
    if (!outlineList) return;

    if (headings.length === 0) {
      outlineList.innerHTML = '<li class="outline-empty">暂无标题</li>';
      return;
    }

    outlineList.innerHTML = headings
      .map((h) => {
        const indent = h.level - 1;
        return `<li class="outline-item" data-id="${h.id}" style="padding-left: ${indent * 12 + 8}px">
          <a href="#${h.id}" class="outline-link">${h.text || '未命名'}</a>
        </li>`;
      })
      .join('');

    outlineList.querySelectorAll('.outline-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = (link.closest('.outline-item') as HTMLElement)?.dataset.id;
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  document.addEventListener('headings-change', ((e: CustomEvent) => {
    renderOutline(e.detail.headings);
  }) as EventListener);

  let currentActiveId = '';
  function updateActiveHeading() {
    if (!outlineList) return;
    const items = outlineList.querySelectorAll('.outline-item');
    if (items.length === 0) return;

    let activeId = '';
    items.forEach((item) => {
      const id = (item as HTMLElement).dataset.id;
      if (!id) return;
      const el = document.getElementById(id);
      if (el) {
        const rect = el.getBoundingClientRect();
        if (rect.top <= 120) {
          activeId = id;
        }
      }
    });

    if (activeId !== currentActiveId) {
      currentActiveId = activeId;
      items.forEach((item) => {
        item.classList.toggle('active', (item as HTMLElement).dataset.id === activeId);
      });
    }
  }

  if (docMain) {
    docMain.addEventListener('scroll', updateActiveHeading, { passive: true });
  }
</script>

<style>
  :root {
    --doc-bg: #ffffff;
    --text-primary: #37352f;
    --text-secondary: #6b6b6b;
    --text-tertiary: #9b9b9b;
    --border-color: #e3e2e0;
    --hover-bg: #f7f6f3;
    --sidebar-width: 240px;
    --header-height: 52px;
    --content-max-width: 900px;
    --callout-bg: #fff8e6;
    --callout-border: #ffd33d;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    background-color: var(--doc-bg);
    color: var(--text-primary);
    line-height: 1.6;
  }

  .doc-layout {
    margin-left: var(--sidebar-width);
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .doc-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    height: var(--header-height);
  }

  .doc-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 0 4rem;
    max-width: calc(var(--content-max-width) + 8rem);
    margin: 0 auto;
  }

  .doc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--text-primary);
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .doc-actions {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    background: var(--hover-bg);
    color: var(--text-primary);
  }

  .action-btn.primary {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: white;
  }

  .action-btn.primary:hover {
    background: #1a1a1a;
  }

  .action-icon {
    font-size: 0.875rem;
  }

  .doc-main {
    flex: 1;
    display: flex;
    overflow-y: auto;
  }

  .doc-outline {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    width: 220px;
    min-width: 220px;
    max-height: calc(100vh - var(--header-height) - 3rem);
    overflow-y: auto;
    padding: 1.5rem 0.5rem 1.5rem 1.5rem;
    flex-shrink: 0;
    align-self: flex-start;
  }

  .doc-outline :global(.outline-header) {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    padding: 0 8px;
  }

  .doc-outline :global(.outline-list) {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .doc-outline :global(.outline-empty) {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    padding: 0 8px;
    font-style: italic;
  }

  .doc-outline :global(.outline-item) {
    position: relative;
    padding: 0.4rem 8px;
    border-radius: 4px;
    transition: background 0.15s ease;
  }

  .doc-outline :global(.outline-item::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: transparent;
    border-radius: 1px;
    transition: background 0.15s ease;
  }

  .doc-outline :global(.outline-item.active::before) {
    background: var(--text-primary);
  }

  .doc-outline :global(.outline-item.active) {
    background: var(--hover-bg);
  }

  .doc-outline :global(.outline-item:hover) {
    background: var(--hover-bg);
  }

  .doc-outline :global(.outline-link) {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
    line-height: 1.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .doc-outline :global(.outline-item.active .outline-link) {
    color: var(--text-primary);
    font-weight: 500;
  }

  .doc-outline :global(.outline-link:hover) {
    color: var(--text-primary);
  }

  .doc-container {
    flex: 1;
    min-width: 0;
    padding: 3rem 4rem 3rem 2rem;
  }

  .doc-icon {
    font-size: 4rem;
    margin-bottom: 0.5rem;
    cursor: pointer;
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .doc-icon:hover {
    transform: scale(1.1);
  }

  .doc-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    outline: none;
    border: none;
    min-height: 1.2em;
  }

  .doc-title:empty::before {
    content: attr(data-placeholder);
    color: var(--text-tertiary);
  }

  .doc-title:focus {
    border-bottom: 2px solid var(--border-color);
  }

  .doc-editor {
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .doc-layout {
      margin-left: 0;
    }

    .doc-outline {
      display: none;
    }

    .doc-main {
      padding: 1.5rem;
    }

    .doc-container {
      padding: 0;
    }

    .doc-header-content {
      padding: 0 1rem;
    }

    .block-menu {
      right: -1.5rem;
    }
  }
</style>