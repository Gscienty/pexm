---
export interface Props {
  activePath?: string;
}

const { activePath = '/console' } = Astro.props;

const siteName = "笔阵";
const userName = "用户";

const sidebarItems = [
  { icon: "🏠", label: "控制台", href: "/console" },
  { icon: "📄", label: "试卷空间", href: "/console/papers" },
  { icon: "🧩", label: "模板", href: "/console/templates" },
  { icon: "⚙️", label: "设置", href: "/console/settings" },
];

const favorites: { name: string; emoji: string; href: string }[] = [];
---

<!-- Synchronous script to prevent flash on collapsed sidebar -->
<script is:inline>
  if (localStorage.getItem('sidebar-collapsed') === 'true') {
    document.documentElement.classList.add('sidebar-collapsed');
    document.addEventListener('DOMContentLoaded', function() {
      var svg = document.querySelector('#collapseBtn svg');
      if (svg) svg.style.transform = 'rotate(180deg)';
    });
  }
</script>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a href="/" class="logo">
      <img src="/exam-icon.svg" alt="笔阵图标" class="site-icon" />
      <span class="logo-text">{siteName}</span>
    </a>
    <button class="collapse-btn" id="collapseBtn" title="折叠侧栏">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 3L5 8l5 5"/></svg>
    </button>
  </div>

  <div class="sidebar-search">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <span class="search-text">搜索</span>
      <span class="search-shortcut">⌘+P</span>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      {sidebarItems.map(item => (
        <a href={item.href} class={`nav-item ${item.href === activePath ? 'active' : ''}`} title={item.label}>
          <span class="nav-icon">{item.icon}</span>
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="nav-section">
      <div class="section-header">
        <span>收藏</span>
        <button class="add-btn">+</button>
      </div>
      {favorites.map(item => (
        <a href={item.href} class="nav-item" title={item.name}>
          <span class="nav-icon">{item.emoji}</span>
          <span class="nav-label">{item.name}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="user-menu">
      <div class="user-avatar">{userName[0]}</div>
      <span class="user-name">{userName}</span>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar');
  const collapseBtn = document.getElementById('collapseBtn');
  const COLLAPSED_KEY = 'sidebar-collapsed';

  function applyCollapsed(collapsed: boolean) {
    document.documentElement.classList.toggle('sidebar-collapsed', collapsed);
    sidebar?.classList.toggle('collapsed', collapsed);
    collapseBtn?.querySelector('svg')?.style.setProperty('transform', collapsed ? 'rotate(180deg)' : '');
    const ml = collapsed ? '56px' : '240px';
    document.querySelectorAll<HTMLElement>('.main, .doc-layout').forEach(el => {
      el.style.marginLeft = ml;
    });
  }

  // Restore state (html class already set by inline script, sync sidebar class)
  const saved = localStorage.getItem(COLLAPSED_KEY);
  if (saved === 'true') {
    sidebar?.classList.add('collapsed');
    collapseBtn?.querySelector('svg')?.style.setProperty('transform', 'rotate(180deg)');
    document.querySelectorAll<HTMLElement>('.main, .doc-layout').forEach(el => {
      el.style.marginLeft = '56px';
    });
  }

  // Re-enable transitions after initial render
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.documentElement.classList.remove('sidebar-collapsed-no-transition');
    });
  });

  collapseBtn?.addEventListener('click', () => {
    const isCollapsed = !sidebar?.classList.contains('collapsed');
    applyCollapsed(isCollapsed);
    localStorage.setItem(COLLAPSED_KEY, String(isCollapsed));
  });
</script>

<style>
  .sidebar {
    width: 240px;
    background: #f7f6f3;
    border-right: 1px solid #e3e2e0;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
    transition: width 0.2s ease;
  }

  /* Prevent flash: apply collapsed state via html class before JS hydration */
  html.sidebar-collapsed .sidebar {
    width: 56px;
    transition: none;
  }

  html.sidebar-collapsed .sidebar .logo-text,
  html.sidebar-collapsed .sidebar .nav-label,
  html.sidebar-collapsed .sidebar .search-text,
  html.sidebar-collapsed .sidebar .search-shortcut,
  html.sidebar-collapsed .sidebar .user-name,
  html.sidebar-collapsed .sidebar .section-header {
    display: none;
  }

  html.sidebar-collapsed .sidebar .sidebar-search {
    padding: 0 0.5rem 0.5rem;
  }

  html.sidebar-collapsed .sidebar .search-box {
    justify-content: center;
    padding: 0.375rem;
  }

  html.sidebar-collapsed .sidebar .nav-item {
    justify-content: center;
    padding: 0.375rem;
  }

  html.sidebar-collapsed .sidebar .user-menu {
    justify-content: center;
    padding: 0.375rem;
  }

  html.sidebar-collapsed .sidebar .sidebar-header {
    padding: 0.75rem 0.5rem;
    flex-direction: column;
    gap: 0.25rem;
  }

  html.sidebar-collapsed .sidebar .logo {
    padding: 0.375rem;
    gap: 0;
  }

  html.sidebar-collapsed .main {
    margin-left: 56px;
  }

  html.sidebar-collapsed .doc-layout {
    margin-left: 56px;
  }

  .sidebar-header {
    padding: 0.75rem 0.875rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #37352f;
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    transition: background 0.15s ease;
    overflow: hidden;
  }

  .logo:hover {
    background: #ebebea;
  }

  .logo-text {
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.15s ease, width 0.15s ease;
  }

  .collapse-btn {
    background: none;
    border: none;
    color: #6b6b6b;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .collapse-btn:hover {
    background: #ebebea;
    color: #37352f;
  }

  .collapse-btn svg {
    transition: transform 0.2s ease;
  }

  html.sidebar-collapsed .collapse-btn svg {
    transition: none;
  }

  .site-icon {
    width: 20px;
    height: 20px;
  }

  .sidebar-search {
    padding: 0 0.875rem 0.5rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    background: #ebebea;
    border-radius: 4px;
    color: #6b6b6b;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .search-box:hover {
    background: #e3e2e0;
  }

  .search-icon {
    font-size: 0.75rem;
  }

  .search-text {
    flex: 1;
  }

  .search-shortcut {
    font-size: 0.6875rem;
    color: #6b6b6b;
    opacity: 0.6;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0 0.5rem;
  }

  .nav-section {
    margin-bottom: 0.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.375rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #6b6b6b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .add-btn {
    background: none;
    border: none;
    color: #6b6b6b;
    font-size: 1rem;
    cursor: pointer;
    padding: 0 0.25rem;
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .add-btn:hover {
    background: #ebebea;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 4px;
    color: #37352f;
    text-decoration: none;
    font-size: 0.875rem;
    transition: background 0.15s ease;
    margin-bottom: 1px;
  }

  .nav-item:hover {
    background: #ebebea;
  }

  .nav-item.active {
    background: #e3e2e0;
    font-weight: 500;
  }

  .nav-icon {
    font-size: 0.875rem;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .nav-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-footer {
    padding: 0.5rem;
    border-top: 1px solid #e3e2e0;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .user-menu:hover {
    background: #ebebea;
  }

  .user-avatar {
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: #4A90E2;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.625rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .user-name {
    font-size: 0.875rem;
    color: #37352f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Collapsed state ---- */
  .sidebar.collapsed {
    width: 56px;
  }

  .sidebar.collapsed .logo-text,
  .sidebar.collapsed .nav-label,
  .sidebar.collapsed .search-text,
  .sidebar.collapsed .search-shortcut,
  .sidebar.collapsed .user-name,
  .sidebar.collapsed .section-header {
    display: none;
  }

  .sidebar.collapsed .sidebar-search {
    padding: 0 0.5rem 0.5rem;
  }

  .sidebar.collapsed .search-box {
    justify-content: center;
    padding: 0.375rem;
  }

  .sidebar.collapsed .nav-item {
    justify-content: center;
    padding: 0.375rem;
  }

  .sidebar.collapsed .user-menu {
    justify-content: center;
    padding: 0.375rem;
  }

  .sidebar.collapsed .sidebar-header {
    padding: 0.75rem 0.5rem;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar.collapsed .logo {
    padding: 0.375rem;
    gap: 0;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }

    .sidebar.open {
      transform: translateX(0);
    }
  }
</style>
