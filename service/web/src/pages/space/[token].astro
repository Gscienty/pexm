---
export const prerender = false;

import Sidebar from '../../components/console/Sidebar.astro';

const siteName = "笔阵";
const { token } = Astro.params;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>试卷空间 - {siteName}</title>
	</head>
	<body>
		<Sidebar activePath="/console/papers" />

		<main class="main">
			<div class="content">
				<div class="breadcrumb">
					<a href="/console" class="breadcrumb-item">控制台</a>
					<span class="breadcrumb-sep">/</span>
					<a href="/console/papers" class="breadcrumb-item">试卷空间</a>
					<span class="breadcrumb-sep">/</span>
					<span class="breadcrumb-item current" id="breadcrumbName">...</span>
				</div>

				<div id="pageContent" style="display:none">
					<div class="repo-header" id="repoHeader">
						<div class="repo-header-top">
							<div class="repo-header-left">
								<span class="repo-icon">📐</span>
								<div class="repo-header-info">
									<h1 class="repo-title" id="spaceName">-</h1>
									<p class="repo-desc" id="spaceDesc">-</p>
								</div>
							</div>
							<div class="repo-header-actions">
								<button class="btn-create" id="btnNewPaper">+ 新建试卷</button>
								<button class="btn-create" id="btnManage">⚙ 空间设置</button>
							</div>
						</div>
						<div class="repo-stats">
							<span class="repo-stat">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
								<span id="memberCount">-</span> 成员
							</span>
							<span class="repo-stat">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
								<span id="paperCount">-</span> 试卷
							</span>
							<span class="repo-stat" id="lastUpdated">-</span>
						</div>

						<div class="repo-tabs">
							<button class="repo-tab active" data-tab="papers">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
								试卷
							</button>
							<button class="repo-tab" data-tab="members">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
								成员
							</button>
							<button class="repo-tab" data-tab="settings">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
								设置
							</button>
						</div>
					</div>

					<div class="tab-content" id="tabPapers">
						<!-- Wiki-style directory breadcrumb -->
						<div class="dir-toolbar">
							<div class="dir-breadcrumb" id="dirBreadcrumb" style="display:none">
								<a href="#" class="dir-crumb" data-dir-id="0">根目录</a>
							</div>
							<div class="dir-toolbar-right">
								<button class="btn-ghost" id="btnNewFolder">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
									新建目录
								</button>
								<button class="btn-ghost" id="btnNewPaperTab">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
									新建试卷
								</button>
							</div>
						</div>

						<div class="file-list" id="fileList">
							<div class="loading-inline">加载中...</div>
						</div>
					</div>

					<div class="tab-content" id="tabMembers" style="display:none">
						<div class="tab-actions">
							<button class="btn-create" id="btnInvite">+ 邀请成员</button>
						</div>
						<div class="members-list" id="membersList"></div>
					</div>

					<div class="tab-content" id="tabSettings" style="display:none">
						<div class="settings-form">
							<div class="form-group">
								<label for="editName">空间名称</label>
								<input type="text" id="editName" value="" />
							</div>
							<div class="form-group">
								<label for="editDesc">描述</label>
								<textarea id="editDesc" rows="3"></textarea>
							</div>
							<div class="form-actions">
								<button class="btn-submit" id="btnSaveSettings">保存</button>
								<button class="btn-danger" id="btnDeleteSpace">删除空间</button>
							</div>
						</div>
					</div>
				</div>

				<div class="loading" id="loading">加载中...</div>
				<div class="empty-state" id="notFound" style="display:none">
					<div class="empty-icon">🔍</div>
					<p class="empty-title">试卷空间不存在</p>
					<p class="empty-desc">该空间可能已被删除或您没有访问权限</p>
					<a href="/console/papers" class="btn-create">返回试卷空间</a>
				</div>
				<div class="empty-state" id="errorState" style="display:none">
					<div class="empty-icon">⚠️</div>
					<p class="empty-title" id="errorMsg">加载失败</p>
					<a href="/console/papers" class="btn-create">返回试卷空间</a>
				</div>
			</div>
		</main>

	<script>
		const BFF_BASE = '';
		const spaceToken = window.location.pathname.split('/').pop() || '';

		async function checkAuth() {
			try {
				const res = await fetch(`${BFF_BASE}/api/auth/me`, { credentials: 'include' });
				if (!res.ok) { window.location.href = '/login'; return null; }
				return res.json();
			} catch {
				window.location.href = '/login';
				return null;
			}
		}

		async function graphqlRequest(query, variables = {}) {
			const res = await fetch(`${BFF_BASE}/api/graphql`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				credentials: 'include',
				body: JSON.stringify({ query, variables }),
			});
			if (!res.ok) throw new Error('网络错误');
			const json = await res.json();
			if (json.errors) throw new Error(json.errors[0]?.message || 'GraphQL 错误');
			return json.data;
		}

		async function loadSpace() {
			const data = await graphqlRequest(`query($token: String) { examSpaces(token: $token) { ... on GqlExamSpacePayload { space { id token name description lastUpdatedAt memberCount paperCount } } } }`, { token: spaceToken });
			return data?.examSpaces?.space || null;
		}

		async function loadMembers(spaceId) {
			const data = await graphqlRequest(`query($examSpaceId: String!) { examSpaceMembers(examSpaceId: $examSpaceId) { id userId examSpaceId role username } }`, { examSpaceId: String(spaceId) });
			return data?.examSpaceMembers || [];
		}

		async function loadDirectoryChildren(examSpaceId, parentId) {
			const data = await graphqlRequest(`query($examSpaceId: Int!, $parentId: Int) { directoryChildren(examSpaceId: $examSpaceId, parentId: $parentId) { directories { id examSpaceId parentId name createdAt updatedAt } papers { id examSpaceId directoryId title createdAt updatedAt } } }`, { examSpaceId, parentId });
			return data?.directoryChildren || { directories: [], papers: [] };
		}

		async function loadDirectoryBreadcrumb(directoryId) {
			const data = await graphqlRequest(`query($directoryId: Int!) { directoryBreadcrumb(directoryId: $directoryId) { id name } }`, { directoryId });
			return data?.directoryBreadcrumb || [];
		}

		async function createDirectory(examSpaceId, parentId, name) {
			const data = await graphqlRequest(`mutation($examSpaceId: Int!, $parentId: Int, $name: String!) { createDirectory(examSpaceId: $examSpaceId, parentId: $parentId, name: $name) { id name } }`, { examSpaceId, parentId, name });
			return data?.createDirectory;
		}

		async function createPaper(examSpaceId, directoryId, title) {
			const data = await graphqlRequest(`mutation($examSpaceId: Int!, $directoryId: Int, $title: String!) { createPaper(examSpaceId: $examSpaceId, directoryId: $directoryId, title: $title) { id title } }`, { examSpaceId, directoryId, title });
			return data?.createPaper;
		}

		async function deleteDirectory(id) {
			await graphqlRequest(`mutation($id: Int!) { deleteDirectory(id: $id) }`, { id });
		}

		async function deletePaper(id) {
			await graphqlRequest(`mutation($id: Int!) { deletePaper(id: $id) }`, { id });
		}

		function formatDate(str) {
			if (!str) return '';
			const d = new Date(str);
			return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
		}

		function roleLabel(role) {
			return role === 'owner' ? '所有者' : role === 'editor' ? '编辑者' : role === 'viewer' ? '查看者' : role;
		}

		function escapeHtml(str) {
			const div = document.createElement('div');
			div.textContent = str;
			return div.innerHTML;
		}

		let currentSpace = null;
		let currentParentId = 0; // 0 = root
		// Breadcrumb stack: [{id: 0, name: '根目录'}, {id: 1, name: '子目录'}, ...]
		let breadcrumbStack = [{ id: 0, name: '根目录' }];

		function renderBreadcrumb() {
			const container = document.getElementById('dirBreadcrumb')!;
			if (breadcrumbStack.length <= 1) {
				container.style.display = 'none';
				return;
			}
			container.style.display = 'flex';

			// When too many items, collapse middle with ellipsis
			const maxVisible = 5; // show first + last two + one more before collapsing
			let items = breadcrumbStack;
			let collapsed = false;
			let collapseStart = -1;
			let collapseEnd = -1;

			if (items.length > maxVisible + 1) {
				// Show first, ellipsis, last two
				collapsed = true;
				collapseStart = 1;
				collapseEnd = items.length - 2;
			}

			let html = '';
			items.forEach((item, idx) => {
				const isLast = idx === items.length - 1;

				// Skip collapsed items
				if (collapsed && idx >= collapseStart && idx < collapseEnd) {
					if (idx === collapseStart) {
						html += `<span class="dir-ellipsis" title="${items.slice(collapseStart, collapseEnd).map(i => escapeHtml(i.name)).join(' / ')}">...</span><span class="dir-sep">/</span>`;
					}
					return;
				}

				if (isLast) {
					html += `<span class="dir-crumb current">${escapeHtml(item.name)}</span>`;
				} else {
					html += `<a href="#" class="dir-crumb" data-dir-id="${item.id}" data-crumb-idx="${idx}">${escapeHtml(item.name)}</a><span class="dir-sep">/</span>`;
				}
			});

			container.innerHTML = html;

			// Bind click events
			container.querySelectorAll('.dir-crumb[data-dir-id]').forEach(el => {
				el.addEventListener('click', (e) => {
					e.preventDefault();
					const crumbIdx = parseInt((el as HTMLElement).dataset.crumbIdx || '0');
					const dirId = parseInt((el as HTMLElement).dataset.dirId || '0');
					breadcrumbStack = breadcrumbStack.slice(0, crumbIdx + 1);
					currentParentId = dirId;
					loadAndRenderChildren();
				});
			});

			// Click ellipsis to expand all
			container.querySelectorAll('.dir-ellipsis').forEach(el => {
				el.addEventListener('click', () => {
					collapsed = false;
					renderBreadcrumb();
				});
			});
		}

		async function loadAndRenderChildren() {
			if (!currentSpace) return;
			const fileList = document.getElementById('fileList')!;
			fileList.innerHTML = '<div class="loading-inline">加载中...</div>';

			try {
				const parentId = currentParentId === 0 ? null : currentParentId;
				const children = await loadDirectoryChildren(currentSpace.id, parentId);
				renderFileList(children.directories, children.papers);
			} catch (e) {
				fileList.innerHTML = `<div class="empty-tab"><p class="empty-title">加载失败</p></div>`;
				console.error('load children error:', e);
			}
			renderBreadcrumb();
		}

		function renderFileList(directories, papers) {
			const fileList = document.getElementById('fileList')!;
			const hasContent = directories.length > 0 || papers.length > 0;

			if (!hasContent) {
				fileList.innerHTML = `
					<div class="empty-tab">
						<div class="empty-icon">📂</div>
						<p class="empty-title">此目录为空</p>
						<p class="empty-desc">新建目录或试卷开始组织内容</p>
					</div>`;
				return;
			}

			let html = '<div class="file-table">';
			// Directories
			for (const dir of directories) {
				html += `
					<div class="file-row dir-row" data-dir-id="${dir.id}">
						<div class="file-icon">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="#8CA5C8" stroke="none"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
						</div>
						<div class="file-name">
							<a href="#" class="dir-link" data-dir-id="${dir.id}" data-dir-name="${escapeHtml(dir.name)}">${escapeHtml(dir.name)}</a>
						</div>
						<div class="file-date">${formatDate(dir.updatedAt)}</div>
						<div class="file-actions">
							<button class="file-action-btn" data-action="delete-dir" data-id="${dir.id}" title="删除目录">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
							</button>
						</div>
					</div>`;
			}
			// Papers
			for (const paper of papers) {
				html += `
					<div class="file-row paper-row" data-paper-id="${paper.id}">
						<div class="file-icon">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5B8EDE" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
						</div>
						<div class="file-name">
							<a href="/doc/${paper.id}?space=${encodeURIComponent(spaceToken)}" class="paper-link">${escapeHtml(paper.title)}</a>
						</div>
						<div class="file-date">${formatDate(paper.updatedAt)}</div>
						<div class="file-actions">
							<button class="file-action-btn" data-action="delete-paper" data-id="${paper.id}" title="删除试卷">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
							</button>
						</div>
					</div>`;
			}
			html += '</div>';
			fileList.innerHTML = html;

			// Bind directory click events
			fileList.querySelectorAll('.dir-link').forEach(el => {
				el.addEventListener('click', (e) => {
					e.preventDefault();
					const dirId = parseInt((el as HTMLElement).dataset.dirId || '0');
					const dirName = (el as HTMLElement).dataset.dirName || '';
					currentParentId = dirId;
					breadcrumbStack.push({ id: dirId, name: dirName });
					loadAndRenderChildren();
				});
			});

			// Bind delete events
			fileList.querySelectorAll('[data-action="delete-dir"]').forEach(btn => {
				btn.addEventListener('click', async () => {
					const id = parseInt((btn as HTMLElement).dataset.id || '0');
					if (confirm('确定删除此目录？目录下的试卷将移至上级目录。')) {
						try {
							await deleteDirectory(id);
							loadAndRenderChildren();
						} catch (e) {
							alert('删除失败: ' + (e as Error).message);
						}
					}
				});
			});

			fileList.querySelectorAll('[data-action="delete-paper"]').forEach(btn => {
				btn.addEventListener('click', async () => {
					const id = parseInt((btn as HTMLElement).dataset.id || '0');
					if (confirm('确定删除此试卷？')) {
						try {
							await deletePaper(id);
							loadAndRenderChildren();
						} catch (e) {
							alert('删除失败: ' + (e as Error).message);
						}
					}
				});
			});
		}

		function showCreateModal(type) {
			// Remove existing modal
			document.getElementById('createModal')?.remove();

			const title = type === 'directory' ? '新建目录' : '新建试卷';
			const placeholder = type === 'directory' ? '目录名称' : '试卷标题';
			const modal = document.createElement('div');
			modal.id = 'createModal';
			modal.className = 'modal-overlay';
			modal.innerHTML = `
				<div class="modal">
					<div class="modal-header">
						<span class="modal-title">${title}</span>
						<button class="modal-close" id="modalClose">&times;</button>
					</div>
					<div class="form-group">
						<input type="text" id="createInput" placeholder="${placeholder}" autofocus />
					</div>
					<div class="form-actions">
						<button class="btn-submit" id="modalSubmit">创建</button>
					</div>
				</div>`;
			document.body.appendChild(modal);

			const input = document.getElementById('createInput') as HTMLInputElement;
			input.focus();

			const closeModal = () => modal.remove();
			document.getElementById('modalClose')?.addEventListener('click', closeModal);
			modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

			document.getElementById('modalSubmit')?.addEventListener('click', async () => {
				const value = input.value.trim();
				if (!value) return;
				try {
					if (type === 'directory') {
						const parentId = currentParentId === 0 ? null : currentParentId;
						await createDirectory(currentSpace.id, parentId, value);
					} else {
						const directoryId = currentParentId === 0 ? null : currentParentId;
						await createPaper(currentSpace.id, directoryId, value);
					}
					closeModal();
					loadAndRenderChildren();
				} catch (e) {
					alert('创建失败: ' + (e as Error).message);
				}
			});

			input.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') document.getElementById('modalSubmit')?.click();
			});
		}

		async function navigateToDirectory(dirId) {
			if (dirId === 0) {
				currentParentId = 0;
				breadcrumbStack = [{ id: 0, name: '根目录' }];
			} else {
				// Load breadcrumb for this directory
				const items = await loadDirectoryBreadcrumb(dirId);
				breadcrumbStack = [{ id: 0, name: '根目录' }, ...items.map(item => ({ id: item.id, name: item.name }))];
				currentParentId = dirId;
			}
			await loadAndRenderChildren();
		}

		async function init() {
			const auth = await checkAuth();
			if (!auth) return;

			// Check URL for ?dir= parameter
			const urlParams = new URLSearchParams(window.location.search);
			const dirParam = urlParams.get('dir');

			try {
				const space = await loadSpace();
				document.getElementById('loading')!.style.display = 'none';

				if (!space) {
					document.getElementById('notFound')!.style.display = 'flex';
					return;
				}

				currentSpace = space;

				// Header
				document.getElementById('breadcrumbName')!.textContent = space.name;
				document.title = `${space.name} - 笔阵`;
				document.getElementById('spaceName')!.textContent = space.name;
				document.getElementById('spaceDesc')!.textContent = space.description || '暂无描述';
				document.getElementById('memberCount')!.textContent = String(space.memberCount);
				document.getElementById('paperCount')!.textContent = String(space.paperCount);
				document.getElementById('lastUpdated')!.textContent = formatDate(space.lastUpdatedAt);

				// Settings form
				(document.getElementById('editName') as HTMLInputElement).value = space.name;
				(document.getElementById('editDesc') as HTMLTextAreaElement).value = space.description || '';

				// Load directory children - navigate to specific dir if ?dir= is set
				if (dirParam) {
					await navigateToDirectory(parseInt(dirParam));
				} else {
					await loadAndRenderChildren();
				}

				// Members
				const members = await loadMembers(space.id);
				const membersList = document.getElementById('membersList')!;
				if (members.length === 0) {
					membersList.innerHTML = '<div class="empty-tab"><p class="empty-title">暂无成员</p></div>';
				} else {
					membersList.innerHTML = members.map(m => `
						<div class="member-row">
							<div class="member-avatar">${m.username.charAt(0).toUpperCase()}</div>
							<div class="member-info">
								<span class="member-name">${escapeHtml(m.username)}</span>
								<span class="member-role">${roleLabel(m.role)}</span>
							</div>
						</div>
					`).join('');
				}

				document.getElementById('pageContent')!.style.display = 'block';
			} catch (e) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('errorState')!.style.display = 'flex';
				document.getElementById('errorMsg')!.textContent = (e as Error).message || '加载失败';
				console.error('load error:', e);
			}

			// Tab switching
			document.querySelectorAll('.repo-tab').forEach(tab => {
				tab.addEventListener('click', () => {
					const tabName = (tab as HTMLElement).dataset.tab!;
					document.querySelectorAll('.repo-tab').forEach(t => t.classList.remove('active'));
					tab.classList.add('active');
					document.querySelectorAll('.tab-content').forEach((c: any) => c.style.display = 'none');
					document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1))!.style.display = 'block';
				});
			});

			// Buttons
			document.getElementById('btnNewPaper')?.addEventListener('click', () => {
				showCreateModal('paper');
			});
			document.getElementById('btnNewPaperTab')?.addEventListener('click', () => {
				showCreateModal('paper');
			});
			document.getElementById('btnNewFolder')?.addEventListener('click', () => {
				showCreateModal('directory');
			});
			document.getElementById('btnManage')?.addEventListener('click', () => {
				// Switch to settings tab
				document.querySelectorAll('.repo-tab').forEach(t => t.classList.remove('active'));
				document.querySelector('.repo-tab[data-tab="settings"]')?.classList.add('active');
				document.querySelectorAll('.tab-content').forEach((c: any) => c.style.display = 'none');
				document.getElementById('tabSettings')!.style.display = 'block';
			});
		}

		init();
	</script>
	</body>
</html>

