---
export const prerender = false;

import Sidebar from '../../components/console/Sidebar.astro';
import './space.css';

const siteName = "笔阵";
const { token } = Astro.params;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>试卷空间 - {siteName}</title>
	</head>
	<body>
		<Sidebar activePath="/console/papers" />

		<main class="main">
			<div class="content">
				<div class="breadcrumb">
					<a href="/console" class="breadcrumb-item">控制台</a>
					<span class="breadcrumb-sep">/</span>
					<a href="/console/papers" class="breadcrumb-item">试卷空间</a>
					<span class="breadcrumb-sep">/</span>
					<span class="breadcrumb-item current" id="breadcrumbName">...</span>
				</div>

				<div id="pageContent" style="display:none">
					<div class="repo-header" id="repoHeader">
						<div class="repo-header-top">
							<h1 class="repo-title" id="spaceName">-</h1>
							<span class="repo-desc" id="spaceDesc">-</span>
						</div>
						<div class="repo-tabs-row">
							<div class="repo-tabs">
								<button class="repo-tab active" data-tab="papers">试卷</button>
								<button class="repo-tab" data-tab="settings">设置</button>
							</div>
							<div class="repo-tabs-actions">
								<button class="btn-text" id="btnNewFolder">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
									新建目录
								</button>
								<button class="btn-text" id="btnNewPaperTab">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
									新建试卷
								</button>
							</div>
						</div>
					</div>

					<div class="tab-content" id="tabPapers">
						<div class="dir-breadcrumb" id="dirBreadcrumb" style="display:none">
							<a href="#" class="dir-crumb" data-dir-id="0">根目录</a>
						</div>

						<div class="file-list" id="fileList">
							<div class="loading-inline">加载中...</div>
						</div>
					</div>

					<div class="tab-content" id="tabSettings" style="display:none">
						<div class="settings-card">
							<div class="settings-card-header">
								<h3 class="settings-card-title">基本信息</h3>
							</div>
							<div class="settings-card-body">
								<div class="settings-field">
									<label class="settings-label" for="editName">空间名称</label>
									<input class="settings-input" type="text" id="editName" value="" />
								</div>
								<div class="settings-field">
									<label class="settings-label" for="editDesc">描述</label>
									<textarea class="settings-input settings-textarea" id="editDesc" rows="3"></textarea>
								</div>
								<div class="settings-card-footer">
									<button class="btn-outline" id="btnSaveSettings">保存修改</button>
								</div>
							</div>
						</div>

						<div class="settings-card">
							<div class="settings-card-header">
								<h3 class="settings-card-title">成员</h3>
								<button class="btn-text" id="btnInvite">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
									邀请成员
								</button>
							</div>
							<div class="settings-card-body">
								<div class="members-list" id="membersList"></div>
							</div>
						</div>

						<div class="settings-card settings-card-danger">
							<div class="settings-card-header">
								<h3 class="settings-card-title">危险操作</h3>
							</div>
							<div class="settings-card-body">
								<p class="settings-hint">删除空间后，所有目录和试卷将被永久清除，此操作不可恢复。</p>
								<button class="btn-danger" id="btnDeleteSpace">删除空间</button>
							</div>
						</div>
					</div>
				</div>

				<div class="loading" id="loading">加载中...</div>
				<div class="empty-state" id="notFound" style="display:none">
					<div class="empty-icon">🔍</div>
					<p class="empty-title">试卷空间不存在</p>
					<p class="empty-desc">该空间可能已被删除或您没有访问权限</p>
					<a href="/console/papers" class="btn-create">返回试卷空间</a>
				</div>
				<div class="empty-state" id="errorState" style="display:none">
					<div class="empty-icon">⚠️</div>
					<p class="empty-title" id="errorMsg">加载失败</p>
					<a href="/console/papers" class="btn-create">返回试卷空间</a>
				</div>
			</div>
		</main>

	<script>
		import { checkAuth, loadSpace, loadMembers, loadDirectoryChildren, loadDirectoryBreadcrumb, createPaper, updateExamSpace, graphqlRequest } from './api';
		import { renderBreadcrumb, setBreadcrumbStack, setOnNavigate } from './breadcrumb';
		import { renderFileList, setOnRefresh } from './file-list';
		import { showCreateModal, setOnRefresh as setModalOnRefresh } from './modals';
		import { setRenameModalFn } from './breadcrumb';
		import { showRenameModal } from './modals';
		import { setupInlineEdit } from './inline-edit';

		const spaceToken = window.location.pathname.split('/').pop() || '';

		let currentSpace: any = null;
		let currentParentId = 0;

		function escapeHtml(str: string) {
			const div = document.createElement('div');
			div.textContent = str;
			return div.innerHTML;
		}

		function roleLabel(role: string) {
			return role === 'owner' ? '所有者' : role === 'editor' ? '编辑者' : role === 'viewer' ? '查看者' : role;
		}

		function showToast(msg: string) {
			const existing = document.querySelector('.toast');
			if (existing) existing.remove();
			const toast = document.createElement('div');
			toast.className = 'toast';
			toast.textContent = msg;
			document.body.appendChild(toast);
			requestAnimationFrame(() => toast.classList.add('show'));
			setTimeout(() => {
				toast.classList.remove('show');
				setTimeout(() => toast.remove(), 300);
			}, 2000);
		}

		// Wire up cross-module callbacks
		setRenameModalFn(showRenameModal);
		setOnRefresh(loadAndRenderChildren);
		setModalOnRefresh(loadAndRenderChildren);

		setOnNavigate((parentId: number) => {
			currentParentId = parentId;
			loadAndRenderChildren();
		});

		// Listen for directory navigation from file-list
		document.getElementById('fileList')!.addEventListener('navigate-dir', ((e: CustomEvent) => {
			currentParentId = e.detail.dirId;
			const stack = [{ id: 0, name: '根目录' as string }];
			// Build breadcrumb by pushing the new dir
			setBreadcrumbStack([...stack, { id: e.detail.dirId, name: e.detail.dirName }]);
			loadAndRenderChildren();
		}) as EventListener);

		async function loadAndRenderChildren() {
			if (!currentSpace) return;
			const fileList = document.getElementById('fileList')!;
			fileList.innerHTML = '<div class="loading-inline">加载中...</div>';

			try {
				const parentId = currentParentId === 0 ? null : currentParentId;
				const children = await loadDirectoryChildren(currentSpace.id, parentId);
				renderFileList(children.directories, children.papers);
			} catch (e) {
				fileList.innerHTML = `<div class="empty-tab"><p class="empty-title">加载失败</p></div>`;
				console.error('load children error:', e);
			}
			renderBreadcrumb();
		}

		async function navigateToDirectory(dirId: number) {
			if (dirId === 0) {
				currentParentId = 0;
				setBreadcrumbStack([{ id: 0, name: '根目录' }]);
			} else {
				const items = await loadDirectoryBreadcrumb(dirId);
				setBreadcrumbStack([{ id: 0, name: '根目录' }, ...items.map((item: any) => ({ id: item.id, name: item.name }))]);
				currentParentId = dirId;
			}
			await loadAndRenderChildren();
		}

		async function init() {
			const auth = await checkAuth();
			if (!auth) return;

			const urlParams = new URLSearchParams(window.location.search);
			const dirParam = urlParams.get('dir');

			try {
				const space = await loadSpace(spaceToken);
				document.getElementById('loading')!.style.display = 'none';

				if (!space) {
					document.getElementById('notFound')!.style.display = 'flex';
					return;
				}

				currentSpace = space;

				// Header
				document.getElementById('breadcrumbName')!.textContent = space.name;
				document.title = `${space.name} - 笔阵`;
				document.getElementById('spaceName')!.textContent = space.name;
				document.getElementById('spaceDesc')!.textContent = space.description || '';

				// Inline edit
				setupInlineEdit(() => currentSpace);

				// Settings form
				(document.getElementById('editName') as HTMLInputElement).value = space.name;
				(document.getElementById('editDesc') as HTMLTextAreaElement).value = space.description || '';

				// Load directory children
				if (dirParam) {
					await navigateToDirectory(parseInt(dirParam));
				} else {
					await loadAndRenderChildren();
				}

				// Members
				const members = await loadMembers(space.id);
				const membersList = document.getElementById('membersList')!;
				if (members.length === 0) {
					membersList.innerHTML = '<div class="empty-tab"><p class="empty-title">暂无成员</p></div>';
				} else {
					membersList.innerHTML = members.map((m: any) => `
						<div class="member-row">
							<div class="member-avatar">${m.username.charAt(0).toUpperCase()}</div>
							<div class="member-info">
								<span class="member-name">${escapeHtml(m.username)}</span>
								<span class="member-role">${roleLabel(m.role)}</span>
							</div>
						</div>
					`).join('');
				}

				document.getElementById('pageContent')!.style.display = 'block';
			} catch (e) {
				document.getElementById('loading')!.style.display = 'none';
				document.getElementById('errorState')!.style.display = 'flex';
				document.getElementById('errorMsg')!.textContent = (e as Error).message || '加载失败';
				console.error('load error:', e);
			}

			// Tab switching
			document.querySelectorAll('.repo-tab').forEach(tab => {
				tab.addEventListener('click', () => {
					const tabName = (tab as HTMLElement).dataset.tab!;
					document.querySelectorAll('.repo-tab').forEach(t => t.classList.remove('active'));
					tab.classList.add('active');
					document.querySelectorAll('.tab-content').forEach((c: any) => c.style.display = 'none');
					document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1))!.style.display = 'block';
					const actions = document.querySelector('.repo-tabs-actions') as HTMLElement;
					if (actions) actions.style.display = tabName === 'settings' ? 'none' : '';
				});
			});

			// Buttons
			document.getElementById('btnNewPaperTab')?.addEventListener('click', async () => {
				if (!currentSpace) return;
				try {
					const directoryId = currentParentId === 0 ? null : currentParentId;
					const result = await createPaper(currentSpace.id, directoryId, '未命名试卷');
					if (result) {
						window.location.href = `/doc/${result.id}?space=${encodeURIComponent(spaceToken)}`;
					}
				} catch (e) {
					alert('创建失败: ' + (e as Error).message);
				}
			});
			document.getElementById('btnNewFolder')?.addEventListener('click', () => {
				showCreateModal('directory', currentSpace.id, currentParentId);
			});

			// Save settings
			document.getElementById('btnSaveSettings')?.addEventListener('click', async () => {
				if (!currentSpace) return;
				const name = (document.getElementById('editName') as HTMLInputElement).value.trim();
				const desc = (document.getElementById('editDesc') as HTMLTextAreaElement).value.trim();
				if (!name) { alert('空间名称不能为空'); return; }
				try {
					await updateExamSpace(currentSpace.id, name, desc);
					currentSpace.name = name;
					currentSpace.description = desc;
					document.getElementById('spaceName')!.textContent = name;
					document.getElementById('spaceDesc')!.textContent = desc;
					document.getElementById('breadcrumbName')!.textContent = name;
					document.title = `${name} - 笔阵`;
					showToast('保存成功');
				} catch (e) {
					alert('保存失败: ' + (e as Error).message);
				}
			});

			// Delete space
			document.getElementById('btnDeleteSpace')?.addEventListener('click', async () => {
				if (!currentSpace) return;
				if (!confirm('确定删除此空间？所有目录和试卷将被永久清除，此操作不可恢复。')) return;
				try {
					await graphqlRequest(`mutation($id: Int!) { deleteExamSpace(id: $id) }`, { id: currentSpace.id });
					window.location.href = '/console/papers';
				} catch (e) {
					alert('删除失败: ' + (e as Error).message);
				}
			});
		}

		init();
	</script>
	</body>
</html>
