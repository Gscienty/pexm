---
import Sidebar from '../../components/console/Sidebar.astro';

const siteName = '笔阵';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>模板管理 - {siteName}</title>
  </head>
  <body>
    <Sidebar activePath="/console/templates" />

    <main class="main">
      <div class="content">
        <div class="breadcrumb">
          <a href="/console" class="breadcrumb-item">控制台</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-item current">模板</span>
        </div>

        <div class="page-header">
          <div>
            <h1 class="page-title">模板管理</h1>
            <p class="page-subtitle">快速复用常用试卷模板，统一排版与风格</p>
          </div>
          <button class="btn-create" id="btnCreate">+ 新增模板</button>
        </div>

        <div id="templatesContainer" class="templates-container">
          <div class="loading" id="loading">加载中...</div>
          <div class="empty-state" id="emptyState" style="display:none">
            <div class="empty-icon">🧩</div>
            <h2 class="empty-title">还没有模板</h2>
            <p class="empty-desc">创建第一个模板，后续可在试卷中直接使用</p>
            <button class="btn-create btn-create-large" id="btnCreateEmpty">+ 新增模板</button>
          </div>
          <div class="templates-grid" id="templatesGrid" style="display:none"></div>
        </div>
      </div>
    </main>

    <div class="modal-overlay" id="modalOverlay" style="display:none">
      <div class="modal">
        <div class="modal-header">
          <h2 class="modal-title">新增模板</h2>
          <button class="modal-close" id="modalClose" type="button">&times;</button>
        </div>
        <form id="createForm">
          <div class="form-group">
            <label for="templateName">模板名称</label>
            <input type="text" id="templateName" name="name" placeholder="输入模板名称" required autofocus />
          </div>
          <div class="form-group">
            <label for="templateDesc">描述（可选）</label>
            <textarea id="templateDesc" name="description" placeholder="简单描述这个模板" rows="2"></textarea>
          </div>
          <div class="form-error" id="formError"></div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" id="modalCancel">取消</button>
            <button type="submit" class="btn-submit">创建</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      interface TemplateItem {
        id: number;
        name: string;
        description: string;
        thumbnail: string;
        accent: string;
      }

      const STORAGE_KEY = 'pexm-templates';
      const defaultTemplates: TemplateItem[] = [
        {
          id: 1,
          name: '标准试卷模板',
          description: '适合日常考试，结构清晰，排版稳定',
          thumbnail: '📘',
          accent: 'linear-gradient(135deg, #6c5ce7 0%, #4f46e5 100%)',
        },
        {
          id: 2,
          name: '竞赛题模板',
          description: '更适合竞赛题与附加题的展示',
          thumbnail: '🏆',
          accent: 'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',
        },
      ];

      let templates: TemplateItem[] = [];

      function loadTemplates() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) {
            templates = defaultTemplates;
            return;
          }
          const parsed = JSON.parse(raw) as TemplateItem[];
          templates = parsed.length > 0 ? parsed : defaultTemplates;
        } catch {
          templates = defaultTemplates;
        }
      }

      function saveTemplates() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(templates));
      }

      function renderTemplates() {
        const grid = document.getElementById('templatesGrid') as HTMLElement;
        const empty = document.getElementById('emptyState') as HTMLElement;
        const loading = document.getElementById('loading') as HTMLElement;

        loading.style.display = 'none';

        if (templates.length === 0) {
          empty.style.display = 'flex';
          grid.style.display = 'none';
          return;
        }

        empty.style.display = 'none';
        grid.style.display = 'grid';
        grid.innerHTML = templates.map((template) => `
          <article class="template-card">
            <div class="template-thumb" style="background: ${template.accent};">
              <span>${template.thumbnail}</span>
            </div>
            <div class="space-card-header">
              <span class="space-card-icon">🧩</span>
              <span class="space-card-name">${escapeHtml(template.name)}</span>
            </div>
            <p class="space-card-desc">${escapeHtml(template.description || '暂无描述')}</p>
            <div class="space-card-footer">
              <span class="space-card-stat">模板</span>
              <span class="space-card-date">可复用</span>
            </div>
          </article>
        `).join('');
      }

      function escapeHtml(text: string) {
        const el = document.createElement('div');
        el.textContent = text;
        return el.innerHTML;
      }

      function openModal() {
        const overlay = document.getElementById('modalOverlay') as HTMLElement;
        overlay.style.display = 'flex';
        (document.getElementById('templateName') as HTMLInputElement).focus();
      }

      function closeModal() {
        const overlay = document.getElementById('modalOverlay') as HTMLElement;
        overlay.style.display = 'none';
        (document.getElementById('createForm') as HTMLFormElement).reset();
        (document.getElementById('formError') as HTMLElement).style.display = 'none';
      }

      function init() {
        loadTemplates();
        renderTemplates();

        document.getElementById('btnCreate')?.addEventListener('click', openModal);
        document.getElementById('btnCreateEmpty')?.addEventListener('click', openModal);
        document.getElementById('modalClose')?.addEventListener('click', closeModal);
        document.getElementById('modalCancel')?.addEventListener('click', closeModal);
        document.getElementById('modalOverlay')?.addEventListener('click', (event) => {
          if (event.target === event.currentTarget) {
            closeModal();
          }
        });

        document.getElementById('createForm')?.addEventListener('submit', (event) => {
          event.preventDefault();
          const form = event.currentTarget as HTMLFormElement;
          const formData = new FormData(form);
          const name = String(formData.get('name') || '').trim();
          const description = String(formData.get('description') || '').trim();
          const formError = document.getElementById('formError') as HTMLElement;

          if (!name) {
            formError.textContent = '模板名称不能为空';
            formError.style.display = 'block';
            return;
          }

          const accent = ['linear-gradient(135deg, #6c5ce7 0%, #4f46e5 100%)', 'linear-gradient(135deg, #0f766e 0%, #14b8a6 100%)', 'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)'][templates.length % 3];
          templates.unshift({
            id: Date.now(),
            name,
            description,
            thumbnail: '📝',
            accent,
          });

          saveTemplates();
          renderTemplates();
          closeModal();
        });
      }

      init();
    </script>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --main-bg: #ffffff;
    --text-primary: #37352f;
    --text-secondary: #6b6b6b;
    --text-tertiary: #9ca3af;
    --border-color: #e3e2e0;
    --hover-bg: #f7f6f3;
    --sidebar-active: #e3e2e0;
    --blue: #4A90E2;
    --blue-hover: #357ABD;
    --radius: 8px;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    background-color: var(--main-bg);
    color: var(--text-primary);
    line-height: 1.5;
    display: flex;
    min-height: 100vh;
  }

  .main {
    flex: 1;
    margin-left: 240px;
    min-height: 100vh;
  }

  .content {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 4rem;
  }

  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .breadcrumb-item {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb-item:hover {
    color: var(--text-primary);
  }

  .breadcrumb-item.current {
    color: var(--text-primary);
    font-weight: 500;
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
    margin: 0 0.375rem;
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
    flex: 1;
  }

  .btn-create {
    padding: 0.5rem 1rem;
    background: transparent;
    color: #8CA5C8;
    border: 1px solid #E0E6EE;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }

  .btn-create:hover {
    color: #5B8EDE;
    border-color: #C8D8ED;
    background: #F5F8FC;
  }

  .btn-create-large {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .templates-container {
    min-height: 320px;
  }

  .loading {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .templates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .template-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: var(--main-bg);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
    min-height: 220px;
  }

  .template-card:hover {
    border-color: var(--blue);
    box-shadow: 0 2px 8px rgba(74, 144, 226, 0.12);
  }

  .template-thumb {
    height: 112px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: white;
    margin-bottom: 0.875rem;
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.15);
  }

  .space-card-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.625rem;
  }

  .space-card-icon {
    font-size: 1.25rem;
  }

  .space-card-name {
    font-size: 0.95rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .space-card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .space-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--border-color);
  }

  .space-card-stat {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .space-card-date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
  }

  .modal {
    background: var(--main-bg);
    border-radius: 12px;
    width: 480px;
    max-width: 90vw;
    padding: 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.16);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .modal-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .modal-close:hover {
    color: var(--text-primary);
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.375rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-error {
    display: none;
    color: #E74C3C;
    font-size: 0.8125rem;
    margin-bottom: 0.75rem;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .btn-cancel {
    padding: 0.5rem 1rem;
    background: var(--hover-bg);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.875rem;
    cursor: pointer;
    color: var(--text-primary);
    transition: background 0.15s ease;
  }

  .btn-cancel:hover {
    background: var(--sidebar-active);
  }

  .btn-submit {
    padding: 0.5rem 1.25rem;
    background: transparent;
    color: #8CA5C8;
    border: 1px solid #E0E6EE;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .btn-submit:hover {
    color: #5B8EDE;
    border-color: #C8D8ED;
    background: #F5F8FC;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 900px) {
    .main {
      margin-left: 56px;
    }

    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 768px) {
    .main {
      margin-left: 0;
    }

    .content {
      padding: 1.5rem;
    }

    .templates-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
